# --- Server ---
PORT=3000
NODE_ENV=development

# --- Auth ---
# Clients must send this value in the `x-api-key` header on every request
# (except /health and /metrics). Change it for real deployments.
API_KEY=local-dev-secret-key

# --- Database (SQLite file, via Prisma) ---
DATABASE_URL="file:./dev.db"

# "prisma" (default) persists to the SQLite file above. "memory" uses an in-process
# adapter with no database at all — useful for quick local runs or tests.
PERSISTENCE_DRIVER=prisma

# --- Logging ---
# One of: fatal, error, warn, info, debug, trace, silent
LOG_LEVEL=info

# --- Third-party services (stubbed) ---
# Toggle a fake latency/failure to see error handling & logging in action.
EMAIL_PROVIDER=console
